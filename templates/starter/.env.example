# .env.example
# Copy to .env.local for development. Never commit .env.local.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/[project-slug]
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/[project-slug]_test

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Auth (BetterAuth) ─────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-string
BETTER_AUTH_URL=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
SERVICE_NAME=[project-slug]

# ── Database pool ─────────────────────────────────────────────────────────────
DATABASE_POOL_MAX=10
