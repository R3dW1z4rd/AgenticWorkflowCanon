{
  "name": "[project-slug]",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev":              "next dev",
    "build":            "next build",
    "start":            "next start",
    "lint":             "next lint",
    "test":             "vitest run",
    "test:watch":       "vitest",
    "test:e2e":         "playwright test",
    "test:e2e:ui":      "playwright test --ui",
    "test:a11y":        "playwright test --config=playwright.a11y.config.ts",
    "db:generate":      "drizzle-kit generate",
    "db:migrate":       "drizzle-kit migrate",
    "db:migrate:down":  "drizzle-kit migrate --rollback",
    "db:studio":        "drizzle-kit studio",
    "db:push":          "drizzle-kit push"
  },
  "dependencies": {
    "next":             "^15.0.0",
    "react":            "^18.3.0",
    "react-dom":        "^18.3.0",
    "better-auth":      "^1.0.0",
    "drizzle-orm":      "^0.38.0",
    "pg":               "^8.13.0",
    "zod":              "^3.23.0",
    "pino":             "^9.6.0",
    "@radix-ui/react-slot": "^1.1.0"
  },
  "devDependencies": {
    "typescript":           "^5.6.0",
    "@types/node":          "^22.0.0",
    "@types/react":         "^18.3.0",
    "@types/react-dom":     "^18.3.0",
    "@types/pg":            "^8.11.0",
    "drizzle-kit":          "^0.29.0",
    "vitest":               "^2.1.0",
    "@vitest/coverage-v8":  "^2.1.0",
    "playwright":           "^1.48.0",
    "@playwright/test":     "^1.48.0",
    "pino-pretty":          "^13.0.0",
    "eslint":               "^9.0.0",
    "eslint-config-next":   "^15.0.0",
    "tailwindcss":          "^3.4.0"
  }
}
